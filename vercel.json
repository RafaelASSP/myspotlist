{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/r/:token", "destination": "/api/r?token=:token" }
  ],
  "functions": {
    "api/r.js": { "includeFiles": "index.html" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
